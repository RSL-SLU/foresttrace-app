# App mode: "development" / "local" or "production"
# Setting APP_MODE=development forces all rasters, tiles, and COGs to route locally
# and directs MongoDB operations to the cloud 'foresttrace_dev' database.
APP_MODE=development

# Groq Inference API key (for Forestry AI Assistant)
GROQ_API_KEY=

# Anthropic API key (for story maps: api/storymaps.js, Claude Sonnet 5)
# Create one at console.anthropic.com; also set it in Vercel project settings.
ANTHROPIC_API_KEY=

# MongoDB Connection Strings
MONGODB_URI=
VERCEL_MONGODB_URI=

# Optional: Override the MongoDB database name directly
# If unset, automatically defaults to:
#   - 'foresttrace' in Vercel Production
#   - 'foresttrace_preview' on Vercel Preview/PR deployments
#   - 'foresttrace_dev' in local development (NODE_ENV=development)
MONGODB_DB_NAME=foresttrace_dev

# Optional: Shared secret for signing session JWT tokens
# AUTH_SECRET=your-secure-random-secret

# Accounts use email + password; no mail provider is needed. To reset a
# password (including the admin's): node scripts/admin/reset-password.js <email> --db <name>
# Chart stats (scripts/stats/refresh-stats.js, also run after every COG upload).
# Clearcut: the boreal-canada-mapping pipeline. PYTHON must be an environment
# with rasterio (e.g. a conda env's python.exe).
# BOREAL_REPO_DIR=../boreal-canada-mapping
# CLEARCUT_RESULTS_DIR=../boreal-canada-mapping/results
# PYTHON=C:/Users/<you>/anaconda3/envs/geo-env/python.exe
# Wildfire: the NBAC tiler's outputs.
# WILDFIRE_PLAN_CSV=
# WILDFIRE_TILES_DIR=
