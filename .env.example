# App mode: "development" / "local" or "production"
# Setting APP_MODE=development forces all rasters, tiles, and COGs to route locally
# and directs MongoDB operations to the cloud 'foresttrace_dev' database.
APP_MODE=development

# Groq Inference API key (for Forestry AI Assistant)
GROQ_API_KEY=

# Anthropic API key (for story maps: api/storymaps.js, Claude Sonnet 5)
# Create one at console.anthropic.com; also set it in Vercel project settings.
ANTHROPIC_API_KEY=

# MongoDB Connection Strings
MONGODB_URI=
VERCEL_MONGODB_URI=

# Optional: Override the MongoDB database name directly
# If unset, automatically defaults to:
#   - 'foresttrace' in Vercel Production
#   - 'foresttrace_preview' on Vercel Preview/PR deployments
#   - 'foresttrace_dev' in local development (NODE_ENV=development)
MONGODB_DB_NAME=foresttrace_dev

# Optional: Shared secret for signing session JWT tokens
# AUTH_SECRET=your-secure-random-secret

# Accounts use email + password, or Google. To reset a password (including the admin's):
#   node scripts/admin/reset-password.js <email> --db <name>
# To create an account (and FMUs it watches for alert emails):
#   node scripts/admin/create-user.js <email> --db <name> --fmus wabigoon

# "Sign in with Google": an OAuth 2.0 Client ID (type "Web application") from
# Google Cloud Console > APIs & Services > Credentials. Add every origin the app
# runs on (http://localhost:3000, the production domain) under "Authorized
# JavaScript origins". Unset hides the button. Not a secret: no client secret is used.
GOOGLE_CLIENT_ID=

# Bot protection on the sign-up form (api/_botGuard.js): Cloudflare Turnstile,
# free at dash.cloudflare.com > Turnstile > Add widget (Managed mode; add the
# production domain and localhost). Both keys on = the "I'm human" check is
# required; either missing = off. A honeypot field and a per-IP limit of
# 5 new accounts/hour and 20/day apply either way.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Email (Resend, resend.com) -- disturbance alert notifications.
# Without RESEND_API_KEY, emails are printed to the server console instead.
RESEND_API_KEY=
# Sender; must be on the domain verified in Resend.
EMAIL_FROM=ForestTrace <notifications@remotesensinglab.org>
# Origin used for links in emails. Set it in production (a cron request
# arrives on the deployment hostname, not the public domain).
# APP_URL=https://foresttrace.remotesensinglab.org
# Vercel Cron sends this as a Bearer token to /api/alerts?action=notify.
# Set any long random string in the Vercel project settings.
CRON_SECRET=

# Chart stats (scripts/stats/refresh-stats.js, also run after every COG upload).
# Clearcut: the boreal-canada-mapping pipeline. PYTHON must be an environment
# with rasterio (e.g. a conda env's python.exe).
# BOREAL_REPO_DIR=../boreal-canada-mapping
# CLEARCUT_RESULTS_DIR=../boreal-canada-mapping/results
# PYTHON=C:/Users/<you>/anaconda3/envs/geo-env/python.exe
# Wildfire: the NBAC tiler's outputs.
# WILDFIRE_PLAN_CSV=
# WILDFIRE_TILES_DIR=
