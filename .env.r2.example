# Cloudflare R2 credentials — copy this file to .env.r2 and fill in values.
# Get these from: Cloudflare Dashboard → R2 → Manage R2 API Tokens
#
# CLOUDFLARE_ACCOUNT_ID : top-right of any R2 page ("Account ID")
# R2_ACCESS_KEY_ID      : generated when you create an R2 API token
# R2_SECRET_ACCESS_KEY  : shown once on token creation
# R2_BUCKET_NAME        : the exact bucket name (e.g. foresttrace-tiles)

CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=