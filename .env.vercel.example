# Vercel Blob Storage credentials — copy this file to .env.vercel and fill in values.
# Get these from: Vercel Dashboard → Your Project / Team → Storage → Create Blob Store / Quickstart
#
# BLOB_READ_WRITE_TOKEN : The full access token generated by Vercel for your Blob Store.
#                         Starts with "vercel_blob_rw_..."
# VERCEL_BLOB_BASE_URL  : The public base URL of the Blob store (e.g. https://<id>.public.blob.vercel-storage.com).
#                         No trailing slash.
#
# For client-side production builds on Vercel, set all three in your Vercel
# Project Settings (Environment Variables) to the same Blob store:
# REACT_APP_COG_BASE_URL=https://<id>.public.blob.vercel-storage.com
# REACT_APP_DATA_BASE_URL=https://<id>.public.blob.vercel-storage.com
# REACT_APP_TILES_BASE_URL=https://<id>.public.blob.vercel-storage.com
#
# COGs:                   node scripts/storage/upload-cogs-vercel.js <folder> <prefix>
# Boundaries, patches,
# biomass tiles:          node scripts/storage/upload-data-vercel.js   (from client/public/)

BLOB_READ_WRITE_TOKEN=
VERCEL_BLOB_BASE_URL=

